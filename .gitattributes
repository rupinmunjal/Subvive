###############################
# Unity Project .gitattributes
###############################

# --- Force text files to use LF endings on all platforms
* text=auto eol=lf

# --- Ensure C# and script files are recognized correctly
*.cs linguist-language=C#
*.shader linguist-language=C#
*.cginc linguist-language=C#
*.compute linguist-language=C#

# --- Prevent GitHub from misclassifying meta and other Unity files
*.meta linguist-language=C#
*.unity linguist-language=C#
*.prefab linguist-language=C#
*.mat linguist-language=C#
*.asset linguist-language=C#

# --- Treat binary Unity assets correctly (no diff/merge)
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.tga binary
*.tif binary
*.tiff binary
*.fbx binary
*.anim binary
*.wav binary
*.mp4 binary
*.dll binary
*.so binary
*.a binary
*.zip binary
*.unitypackage binary

# --- Unity YAML text files (safe to merge)
*.unity merge=unityyamlmerge eol=lf
*.prefab merge=unityyamlmerge eol=lf
*.anim merge=unityyamlmerge eol=lf
*.mat merge=unityyamlmerge eol=lf
*.asset merge=unityyamlmerge eol=lf

# --- Large files handled by Git LFS
*.psd filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text

###############################
# End of Unity .gitattributes
###############################
